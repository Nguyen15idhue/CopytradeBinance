# App
APP_ENV=development
APP_NAME=CopytradeBinance
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8090,http://localhost:5173

# Database
POSTGRES_DB=copytrade
POSTGRES_USER=copytrade
POSTGRES_PASSWORD=copytrade_dev_password
DATABASE_URL=postgresql+asyncpg://copytrade:copytrade_dev_password@db:5432/copytrade

# Auth
JWT_SECRET=dev-only-change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=Admin123!ChangeMe

# Collector (Phase 2)
BAPI_BASE_URL=https://www.binance.com
BAPI_CONCURRENCY=6
BAPI_TIMEOUT_SECONDS=20
BAPI_MAX_RETRIES=5
COLLECTOR_KILL_SWITCH=false
REDIS_URL=redis://redis:6379/0
AUM_PRESET=5000
SCAN_INTERVAL_MIN=60
DEEP_INTERVAL_HOURS_WATCH=6
DEEP_INTERVAL_HOURS_QUALIFIED=12
DEEP_INTERVAL_HOURS_HIGH=24
RAW_ARCHIVE_DIR=data/raw

# AI (OpenRouter — Phase 5)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
AI_MONTHLY_BUDGET_USD=20
AI_TIMEOUT_SECONDS=60

# AI Agent web search (Tavily — Phase 6b)
TAVILY_API_KEY=
AGENT_WEB_SEARCH_ENABLED=true
AGENT_WEB_SEARCH_MAX_RESULTS=5

# Ops
SENTRY_DSN=
BACKUP_DIR=/backups
