# App
APP_ENV=development
APP_NAME=CopytradeBinance
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Database
POSTGRES_DB=copytrade
POSTGRES_USER=copytrade
POSTGRES_PASSWORD=copytrade_dev_password
DATABASE_URL=postgresql+asyncpg://copytrade:copytrade_dev_password@db:5432/copytrade

# Auth
JWT_SECRET=dev-only-change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=Admin123!ChangeMe

# Collector (Phase 2)
BAPI_BASE_URL=https://www.binance.com
BAPI_CONCURRENCY=6
BAPI_TIMEOUT_SECONDS=20
BAPI_MAX_RETRIES=4
COLLECTOR_KILL_SWITCH=false

# AI (Phase 5)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_USD=20

# Ops
SENTRY_DSN=
BACKUP_DIR=/backups
